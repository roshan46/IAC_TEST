variable "aws_region" {
  type    = string
  default = "us-east-2"
}

variable "project_name" {
  type    = string
  default = "order-manager"
}

variable "environment" {
  type    = string
  default = "dev"
}

variable "learner_cidr" {
  description = "Your current public IPv4 address followed by /32; never 0.0.0.0/0."
  type        = string
  validation {
    condition     = can(cidrnetmask(var.learner_cidr)) && can(regex("/32$", var.learner_cidr))
    error_message = "Use a single IPv4 /32 address."
  }
}

variable "artifact_bucket" {
  type = string
}

variable "release_sha" {
  description = "Full Git SHA used by scripts/package.py and release object keys."
  type        = string
  default     = null
  validation {
    condition     = var.release_sha == null ? true : can(regex("^[0-9a-f]{40}$", var.release_sha))
    error_message = "Use a full lowercase commit SHA."
  }
}

variable "lambda_hashes" {
  description = "Base64 SHA256 of each Lambda ZIP, generated by the plan script."
  type        = map(string)
  default     = {}
  validation {
    condition     = alltrue([for name, hash in var.lambda_hashes : contains(["validate", "fulfill", "receipt"], name) && can(regex("^[A-Za-z0-9+/]{43}=$", hash))])
    error_message = "Lambda hashes must be base64 SHA256 values keyed by validate, fulfill, or receipt."
  }
}

variable "lambda_package_directory" {
  description = "Local ZIP directory relative to infra/dev; null uses the CI S3 release inputs instead."
  type        = string
  default     = null
}

variable "db_instance_class" {
  type    = string
  default = "db.t3.micro"
}

variable "ec2_instance_type" {
  type    = string
  default = "t3.micro"
}

variable "ami_id" {
  description = "Pinned Canonical Ubuntu 24.04 x86_64 AMI in the selected region."
  type        = string
  validation {
    condition     = can(regex("^ami-[0-9a-f]{17}$", var.ami_id))
    error_message = "Provide a region-specific Ubuntu AMI ID."
  }
}

variable "availability_zones" {
  description = "Two distinct standard AZs in the chosen region."
  type        = list(string)
  default     = ["us-east-2a", "us-east-2b"]
  validation {
    condition     = length(var.availability_zones) == 2 && length(distinct(var.availability_zones)) == 2 && alltrue([for az in var.availability_zones : startswith(az, var.aws_region)])
    error_message = "Choose two distinct AZs in aws_region."
  }
}

variable "db_engine_version" {
  description = "Pinned PostgreSQL 17 minor version; review upgrades deliberately."
  type        = string
  default     = "17.11"
  validation {
    condition     = can(regex("^17\\.[0-9]+$", var.db_engine_version))
    error_message = "Use a supported PostgreSQL 17 version matching the parameter-group family."
  }
}

variable "db_skip_final_snapshot" {
  description = "Disposable demo data: true deletes without a final snapshot. Set false to preserve one."
  type        = bool
  default     = true
}

variable "db_final_snapshot_identifier" {
  description = "Unique final snapshot name required when db_skip_final_snapshot is false."
  type        = string
  default     = null
  validation {
    condition     = var.db_final_snapshot_identifier == null ? true : can(regex("^[a-zA-Z][a-zA-Z0-9-]{0,253}[a-zA-Z0-9]$", var.db_final_snapshot_identifier)) && !strcontains(var.db_final_snapshot_identifier, "--")
    error_message = "Use a valid RDS snapshot identifier without consecutive or trailing hyphens."
  }
}
